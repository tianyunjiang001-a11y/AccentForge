# Configuration template only. Do not place real credentials here.
KIMI_API_KEY=
# Mainland China: https://api.moonshot.cn/v1
# International: https://api.moonshot.ai/v1
KIMI_BASE_URL=
KIMI_TEXT_MODEL=kimi-k2.6

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_TTS_MODEL=speech-2.8-turbo
# Phase 6B human-approved natural delivery speed.
MINIMAX_TTS_SPEED=1.0

MINIMAX_BRITISH_FEMALE_VOICE_ID=English_Graceful_Lady
MINIMAX_AMERICAN_FEMALE_VOICE_ID=English_compelling_lady1
MINIMAX_AMERICAN_MALE_VOICE_ID=English_Trustworthy_Man
MINIMAX_AUSTRALIAN_MALE_VOICE_ID=English_Aussie_Bloke

# Phase 7 Worker security settings. Copy local-only values into worker/.dev.vars.
# Production must use a real Turnstile widget and Worker Secrets for the secret.
SECURITY_ENV=development
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Switches accept only "true" or "false"; invalid values fail closed.
API_ENABLED=true
KIMI_ENABLED=true
MINIMAX_ENABLED=true
# The deployed defaults are in worker/wrangler.toml (150 and 40 UTC-day requests).
KIMI_DAILY_REQUEST_LIMIT=150
MINIMAX_DAILY_REQUEST_LIMIT=40
