{
  "name": "accentforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @accentforge/frontend dev",
    "dev:worker": "pnpm --filter @accentforge/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm --filter @accentforge/worker exec tsc -p ../functions/tsconfig.json",
    "lint": "eslint frontend/src worker/src functions",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && node --test tests/phase8b/*.test.mjs",
    "qa:phase4": "node tests/phase4/run-evaluation.mjs",
    "qa:phase4:enrichment": "node tests/phase4/run-evaluation.mjs ./part2-enrichment-cases.json",
    "qa:phase5": "node tests/phase5/run-evaluation.mjs",
    "qa:phase6b": "node tests/phase6b/run-calibration.mjs",
    "qa:phase6b:speed": "node tests/phase6b/run-speed-calibration.mjs",
    "qa:phase6b:part2-normal": "node tests/phase6b/run-normal-speed-part2-validation.mjs",
    "qa:phase6b:part2-full": "node tests/phase6b/run-part2-full-flow-validation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.1"
  }
}
